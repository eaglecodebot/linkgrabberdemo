{
  "manifest_version": 3,
  "name": "Private Workflow Runner",
  "version": "1.9.1",
  "minimum_chrome_version": "120",
  "description": "Trial, personal link capture, and Cancel & Refund workflows.",
  "permissions": [
    "storage",
    "scripting",
    "tabs",
    "webNavigation",
    "alarms"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Private Workflow Runner"
  },
  "options_page": "options.html"
}
